{
    "name": "hosmelq/caniemail",
    "description": "Check which email clients support the HTML and CSS in an email, with data from caniemail.com.",
    "license": "MIT",
    "keywords": [
        "caniemail",
        "caniemail-php",
        "compatibility",
        "css",
        "email",
        "email-clients",
        "hosmelq",
        "html",
        "html-email",
        "php"
    ],
    "authors": [
        {
            "name": "Hosmel Quintana",
            "email": "hosmelq@gmail.com"
        }
    ],
    "homepage": "https://github.com/hosmelq/caniemail-php",
    "support": {
        "docs": "https://github.com/hosmelq/caniemail-php#readme"
    },
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "thecodingmachine/safe": "^3.4",
        "wikimedia/css-sanitizer": "^6.2"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.56",
        "hosmelq/php-coding-standard": "^1.4",
        "laravel/pao": "^1.1",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-agent": "^5.0",
        "pestphp/pest-plugin-rector": "^5.0",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "HosmelQ\\CanIEmail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HosmelQ\\CanIEmail\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "ecs": "ecs check --fix=true",
        "ecs:check": "ecs check",
        "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=4G",
        "rector": "rector",
        "test": "pest",
        "test-coverage": "pest --coverage",
        "update-data": "curl --fail --location --show-error --silent --output data/caniemail.json https://www.caniemail.com/api/data.json"
    },
    "scripts-descriptions": {
        "ecs": "Format PHP code using the shared ECS set.",
        "ecs:check": "Check PHP formatting using the shared ECS set.",
        "phpstan": "Run PHPStan static analysis.",
        "rector": "Run Rector automated refactoring.",
        "test": "Run the test suite using Pest.",
        "test-coverage": "Run the test suite with code coverage using Pest.",
        "update-data": "Download the latest caniemail.com data."
    },
    "$schema": "https://getcomposer.org/schema.json"
}
