{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "zizmorcore/zizmor",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "managerFilePatterns": [".github/workflows/zizmor.yml"],
      "matchStrings": ["version: (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"]
    }
  ],
  "dependencyDashboard": true,
  "enabledManagers": ["composer", "custom.regex", "github-actions"],
  "extends": [
    "config:recommended",
    "group:all",
    "helpers:pinGitHubActionDigests",
    "schedule:weekly"
  ],
  "includePaths": [".github/workflows/**", "composer.json"],
  "minimumReleaseAge": "1 day",
  "packageRules": [
    {
      "matchDepNames": ["pullfrog/pullfrog"],
      "matchManagers": ["github-actions"],
      "pinDigests": false
    },
    {
      "enabled": false,
      "matchDepNames": ["php"],
      "matchManagers": ["composer"]
    },
    {
      "matchManagers": ["composer"],
      "postUpdateOptions": ["composerWithAll"],
      "rangeStrategy": "replace"
    }
  ],
  "rebaseWhen": "conflicted",
  "semanticCommits": "enabled",
  "timezone": "America/Managua",
  "updateNotScheduled": false
}
